<?xml version="1.0" encoding="utf-8"?>
<!-- 侧边栏图标着色：聚焦/选中时点亮为强调色，常态为中性白 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/color_rail_accent" android:state_focused="true" />
    <item android:color="@color/color_rail_accent" android:state_selected="true" />
    <item android:color="@color/color_rail_accent" android:state_pressed="true" />
    <item android:color="@color/color_rail_icon_normal" />
</selector>
