<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page">

    <!-- 独立于 ViewPager 的首页背景层：允许海报覆盖左侧内容区域，但不携带分类页内容 -->
    <FrameLayout
        android:id="@+id/homeHeroLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_settings_page">

        <ImageView
            android:id="@+id/ivHeroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivHeroBackdropAlt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/viewHeroScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_home_scrim_hero" />
    </FrameLayout>

    <!-- 右侧内容区：首页 / 分类页共用（先绘制，侧栏随后覆盖其上） -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:isScrollContainer="false"
        android:orientation="horizontal"
        android:overScrollMode="never">

        <!-- 占位：把内容区顶到侧栏右侧（在经典侧栏模式下生效，全屏顶栏/抽屉模式下隐藏） -->
        <View
            android:id="@+id/sidebarSpacer"
            android:layout_width="@dimen/home_rail_width"
            android:layout_height="match_parent" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- 动态抽屉背景暗色半透明遮罩 -->
    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- 动态抽屉模式下的左边缘悬浮微型手势把手（供触屏/手机用户轻点或拖动呼出抽屉） -->
    <LinearLayout
        android:id="@+id/drawerTabHandle"
        android:layout_width="@dimen/vs_20"
        android:layout_height="@dimen/vs_70"
        android:layout_gravity="center_vertical|left"
        android:background="@drawable/shape_drawer_handle"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="@dimen/vs_3"
            android:layout_height="@dimen/vs_24"
            android:background="#80FFFFFF" />
    </LinearLayout>

    <!-- 左侧导航栏：悬浮在内容区之上 -->
    <com.github.tvbox.osc.ui.tv.widget.NoScrollLinearLayout
        android:id="@+id/leftNavPanel"
        android:layout_width="@dimen/home_rail_width"
        android:layout_height="match_parent"
        android:background="@drawable/shape_home_rail_panel"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_24">

        <!-- 滚动提示：置于品牌标题之上 -->
        <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView
            android:id="@+id/caution_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_4"
            android:ellipsize="marquee"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingLeft="@dimen/vs_24"
            android:paddingRight="@dimen/vs_24"
            android:singleLine="true"
            android:text="软件和影片接口完全免费，软件有问题请联系开发者宗成焕。"
            android:textColor="@color/color_rail_text_muted"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:letterSpacing="0.06"
            android:paddingLeft="@dimen/vs_24"
            android:paddingRight="@dimen/vs_24"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/color_rail_text_active"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:letterSpacing="0.05"
            android:paddingLeft="@dimen/vs_24"
            android:textColor="@color/color_rail_text_muted"
            android:textSize="@dimen/ts_20"
            tools:text="00:00" />

        <!-- 快捷入口 -->
        <LinearLayout
            android:id="@+id/layout_history"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_48"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginTop="@dimen/vs_24"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@drawable/selector_home_rail"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_16"
            android:stateListAnimator="@animator/rail_item_focus_animator">

            <ImageView
                android:layout_width="@dimen/vs_28"
                android:layout_height="@dimen/vs_28"
                android:focusable="false"
                android:src="@drawable/icon_history"
                android:tint="@color/selector_home_rail_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="@dimen/vs_12"
                android:focusable="false"
                android:text="历史"
                android:textColor="@color/selector_home_rail_text"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_live"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_48"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@drawable/selector_home_rail"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_16"
            android:stateListAnimator="@animator/rail_item_focus_animator">

            <ImageView
                android:layout_width="@dimen/vs_28"
                android:layout_height="@dimen/vs_28"
                android:focusable="false"
                android:src="@drawable/icon_live"
                android:tint="@color/selector_home_rail_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="@dimen/vs_12"
                android:focusable="false"
                android:text="直播"
                android:textColor="@color/selector_home_rail_text"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_search2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_48"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@drawable/selector_home_rail"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_16"
            android:stateListAnimator="@animator/rail_item_focus_animator">

            <ImageView
                android:layout_width="@dimen/vs_28"
                android:layout_height="@dimen/vs_28"
                android:focusable="false"
                android:src="@drawable/icon_search"
                android:tint="@color/selector_home_rail_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="@dimen/vs_12"
                android:focusable="false"
                android:text="搜索"
                android:textColor="@color/selector_home_rail_text"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_collect"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_48"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@drawable/selector_home_rail"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_16"
            android:stateListAnimator="@animator/rail_item_focus_animator">

            <ImageView
                android:layout_width="@dimen/vs_28"
                android:layout_height="@dimen/vs_28"
                android:focusable="false"
                android:src="@drawable/icon_collect"
                android:tint="@color/selector_home_rail_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="@dimen/vs_12"
                android:focusable="false"
                android:text="收藏"
                android:textColor="@color/selector_home_rail_text"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_setting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_48"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginRight="@dimen/vs_12"
            android:background="@drawable/selector_home_rail"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_16"
            android:stateListAnimator="@animator/rail_item_focus_animator">

            <ImageView
                android:layout_width="@dimen/vs_28"
                android:layout_height="@dimen/vs_28"
                android:focusable="false"
                android:src="@drawable/icon_setting"
                android:tint="@color/selector_home_rail_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginLeft="@dimen/vs_12"
                android:focusable="false"
                android:text="设置"
                android:textColor="@color/selector_home_rail_text"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <!-- 分隔线：导航入口 与 内容分类 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_1"
            android:layout_marginLeft="@dimen/vs_24"
            android:layout_marginTop="@dimen/vs_16"
            android:layout_marginRight="@dimen/vs_24"
            android:background="@color/color_rail_divider" />

        <!-- 分类 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/sortRV"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:tv_verticalSpacingWithMargins="@dimen/vs_4" />
    </com.github.tvbox.osc.ui.tv.widget.NoScrollLinearLayout>

    <!-- 侧栏与内容区之间的玻璃边缘投影 -->
    <View
        android:id="@+id/sidebarEdgeShadow"
        android:layout_width="@dimen/vs_8"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/home_rail_width"
        android:background="@drawable/shape_home_rail_edge_shadow" />

    <!-- 顶部悬浮导航栏：供 Apple TV 顶栏模式与极简沉浸模式使用 -->
    <LinearLayout
        android:id="@+id/topNavPanel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_54"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_40"
        android:paddingRight="@dimen/vs_40"
        android:paddingTop="@dimen/vs_8"
        android:paddingBottom="@dimen/vs_4"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <!-- 品牌标识与时间胶囊 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_38"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/shape_home_top_brand_pill"
            android:paddingLeft="@dimen/vs_14"
            android:paddingRight="@dimen/vs_14">

            <TextView
                android:id="@+id/tvTopBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_10"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_18"
                tools:text="00:00" />
        </LinearLayout>

        <!-- 顶部横向滚动分类列表 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/sortTopRV"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginRight="@dimen/vs_12"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <!-- 顶部右侧快捷操作胶囊组（放大触控热区至 42mm 并扩大间距，彻底消除手机触控误触） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/top_layout_search"
                android:layout_width="@dimen/vs_42"
                android:layout_height="@dimen/vs_42"
                android:layout_marginLeft="@dimen/vs_8"
                android:background="@drawable/selector_home_top_action"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="@dimen/vs_22"
                    android:layout_height="@dimen/vs_22"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_search"
                    android:tint="@color/selector_home_rail_icon" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/top_layout_history"
                android:layout_width="@dimen/vs_42"
                android:layout_height="@dimen/vs_42"
                android:layout_marginLeft="@dimen/vs_8"
                android:background="@drawable/selector_home_top_action"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="@dimen/vs_22"
                    android:layout_height="@dimen/vs_22"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_history"
                    android:tint="@color/selector_home_rail_icon" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/top_layout_collect"
                android:layout_width="@dimen/vs_42"
                android:layout_height="@dimen/vs_42"
                android:layout_marginLeft="@dimen/vs_8"
                android:background="@drawable/selector_home_top_action"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="@dimen/vs_22"
                    android:layout_height="@dimen/vs_22"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_collect"
                    android:tint="@color/selector_home_rail_icon" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/top_layout_live"
                android:layout_width="@dimen/vs_42"
                android:layout_height="@dimen/vs_42"
                android:layout_marginLeft="@dimen/vs_8"
                android:background="@drawable/selector_home_top_action"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="@dimen/vs_22"
                    android:layout_height="@dimen/vs_22"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_live"
                    android:tint="@color/selector_home_rail_icon" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/top_layout_setting"
                android:layout_width="@dimen/vs_42"
                android:layout_height="@dimen/vs_42"
                android:layout_marginLeft="@dimen/vs_8"
                android:background="@drawable/selector_home_top_action"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="@dimen/vs_22"
                    android:layout_height="@dimen/vs_22"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_setting"
                    android:tint="@color/selector_home_rail_icon" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 打开画面：配置与首页数据全部就绪后再淡出 -->
    <FrameLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_home_base"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_50"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:letterSpacing="0.05"
                android:text="正在加载配置，请稍候…"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:letterSpacing="0.05"
                android:text="请勿轻信任何广告"
                android:textColor="@color/color_99FFFFFF"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
