<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/player_subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginLeft="@dimen/vs_30"
        android:layout_marginRight="@dimen/vs_30"
        android:layout_marginBottom="@dimen/vs_50"
        android:gravity="center"
        android:focusable="false"
        android:clickable="false"
        android:maxLines="4"
        android:shadowColor="#FF000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/bottom_container" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:background="@drawable/shape_play_bottom" android:orientation="vertical"
        android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="18dp"
        android:paddingBottom="12dp" android:visibility="gone">
        <!-- 时间与进度同一基线；长视频时间保留完整数字。 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/curr_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minWidth="64dp" android:layout_marginRight="12dp"
                android:fontFamily="monospace" android:text="00:00" android:textSize="14sp"
                android:textColor="#FFFFFF" android:singleLine="true" />
            <SeekBar android:id="@+id/seekBar" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:background="@null" android:max="10000"
                android:contentDescription="播放进度，左右键快退快进" android:focusable="true"
                android:focusableInTouchMode="true" android:nextFocusDown="@id/playingTV"
                android:minHeight="5dp" android:maxHeight="5dp"
                android:paddingLeft="6dp" android:paddingRight="6dp" android:splitTrack="false"
                android:progressDrawable="@drawable/shape_player_control_vod_seek"
                android:thumb="@drawable/shape_player_control_vod_seek_thumb" android:thumbOffset="0dp" />
            <TextView android:id="@+id/total_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minWidth="64dp" android:layout_marginLeft="12dp"
                android:fontFamily="monospace" android:text="--:--" android:textSize="14sp"
                android:textColor="#D9FFFFFF" android:gravity="end" android:singleLine="true" />
        </LinearLayout>
        <!-- 左侧播放操作，右侧观看设置，左右两端与顶部栏使用相同留白。 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical">
                <ImageButton android:id="@+id/play_pre" style="@style/PlayerOverlayIcon"
                    android:src="@drawable/ic_player_previous" android:contentDescription="上一集" android:layout_marginRight="8dp" />
                <ImageButton android:id="@+id/playingTV" style="@style/PlayerOverlayIcon"
                    android:src="@drawable/ic_player_pause" android:contentDescription="播放或暂停" android:layout_marginRight="8dp" android:nextFocusUp="@id/seekBar" />
                <ImageButton android:id="@+id/play_next" style="@style/PlayerOverlayIcon"
                    android:src="@drawable/ic_player_next" android:contentDescription="下一集"  />
            <HorizontalScrollView android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:fillViewport="true" android:scrollbars="none" android:focusable="false">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="end|center_vertical">
            <Button android:id="@+id/play_retry" style="@style/PlayerOverlayText"
                android:text="重播本集" android:visibility="gone" />
            <TextView android:id="@+id/play_player" style="@style/PlayerOverlayText"
                android:text="系统播放器" android:visibility="gone" />
            <TextView android:id="@+id/play_ijk" style="@style/PlayerOverlayText"
                android:text="硬解码" android:visibility="gone" />
            <Button android:id="@+id/play_speed" style="@style/PlayerOverlayText"
                android:text="x1.0" android:contentDescription="播放速度" android:layout_marginRight="8dp" />
            <TextView android:id="@+id/play_episode" style="@style/PlayerOverlayText"
                android:text="选集" android:contentDescription="选择剧集" android:layout_marginRight="8dp" />
                <ImageButton android:id="@+id/play_scale" style="@style/PlayerOverlayIcon"
                    android:src="@drawable/ic_player_aspect" android:contentDescription="画面比例" android:layout_marginRight="8dp" />
                </LinearLayout>
            </HorizontalScrollView>
            <ImageView android:id="@+id/port_img" style="@style/PlayerOverlayIcon"
                android:src="@drawable/ic_player_rotate" android:contentDescription="切换横竖屏"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="false" android:focusable="false" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                    <Button android:id="@+id/play_subtitle" style="@style/PlayerOverlayText"
                        android:layout_marginRight="8dp" android:text="字幕"
                        android:contentDescription="字幕选择、开关和字号" android:visibility="gone" />
                    <Button android:id="@+id/play_audio" style="@style/PlayerOverlayText"
                        android:layout_marginRight="8dp" android:text="音轨"
                        android:contentDescription="切换音轨" android:visibility="gone" />
                    <Button android:id="@+id/play_time_start" style="@style/PlayerOverlayText"
                        android:layout_marginRight="8dp" android:text="片头 00:00"
                        android:contentDescription="片头跳过时间，点击增加，长按归零" android:visibility="gone" />
                    <Button android:id="@+id/play_time_end" style="@style/PlayerOverlayText"
                        android:layout_marginRight="8dp" android:text="片尾 00:00"
                        android:contentDescription="片尾跳过时间，点击增加，长按归零" android:visibility="gone" />
                    <Button android:id="@+id/play_time_step" style="@style/PlayerOverlayText"
                        android:layout_marginRight="8dp" android:text="步长 5秒"
                        android:contentDescription="调整片头片尾时间的步长" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout
            android:id="@+id/parse_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/vs_5"
                android:layout_marginRight="@dimen/vs_5"
                android:paddingRight="@dimen/vs_10"
                android:text="解析"
                android:textColor="@color/color_99FFFFFF"
                android:textSize="@dimen/ts_24" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/sortRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
        </LinearLayout>
        <TextView
            android:id="@+id/play_ad_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_5"
            android:ellipsize="end"
            android:gravity="right"
            android:singleLine="true"
            android:text="请勿相信视频内广告，否则责任自负"
            android:textColor="@color/color_66FFFFFF"
            android:textSize="@dimen/ts_22"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pause_frg_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:tag="vod_control_pause"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tv_info_name"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="@dimen/vs_20"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />

        <LinearLayout
            android:layout_width="@dimen/vs_280"
            android:layout_height="@dimen/vs_200"
            android:layout_gravity="center"
            android:background="@drawable/selector_pause_root"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:orientation="vertical"
            android:tag="pause_layout">

            <ImageView
                android:layout_width="@dimen/vs_60"
                android:layout_height="@dimen/vs_60"
                android:layout_gravity="center"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:src="@drawable/icon_play" />

            <TextView
                android:id="@+id/tv_pause_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/vs_20"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:tag="vod_control_pause_t"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_30"
                tools:text="100" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_slide_progress_text"
        android:layout_width="@dimen/vs_200"
        android:layout_height="@dimen/vs_70"
        android:layout_gravity="center"
        android:background="@drawable/shape_player_overlay_hint"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:paddingLeft="@dimen/vs_20"
        android:paddingRight="@dimen/vs_20"
        android:tag="vod_control_slide_info"
        android:textAlignment="gravity"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_22"
        android:visibility="gone"
        tools:text="100" />

    <com.github.tvbox.osc.player.view.SpeedBoostView
        android:tag="vod_control_speed_boost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ll_progress_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal"
        android:alpha="0.82"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tv_progress_icon"
                android:layout_width="@dimen/vs_28"
                android:layout_height="@dimen/vs_28"
                android:alpha="0.9"
                tools:src="@drawable/icon_back" />

            <TextView
                android:id="@+id/tv_progress_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_8"
                android:textColor="@color/color_02F8E1"
                android:textSize="@dimen/ts_20"
                android:visibility="gone"
                tools:text="+00:30" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_40"
                android:textStyle="bold"
                tools:text="00:35" />

            <TextView
                android:id="@+id/tv_progress_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_6"
                android:layout_marginBottom="@dimen/vs_6"
                android:textColor="@color/color_6CFFFFFF"
                android:textSize="@dimen/ts_16"
                tools:text="/ 45:00" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/vs_300"
            android:layout_height="@dimen/vs_4"
            android:layout_marginTop="@dimen/vs_15"
            android:background="@drawable/shape_player_seek_track">

            <View
                android:id="@+id/tv_progress_line"
                android:layout_width="@dimen/vs_0"
                android:layout_height="match_parent"
                android:background="@drawable/shape_player_seek_fill" />
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:layout_width="@dimen/vs_50"
        android:layout_height="@dimen/vs_50"
        android:layout_gravity="center"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/anim_loading"
        android:indeterminateOnly="true"
        android:tag="vod_control_loading"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/auto_next_panel"
        android:layout_width="@dimen/vs_420"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|right"
        android:layout_marginRight="@dimen/vs_55"
        android:background="@drawable/shape_player_episode_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_24"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_20"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下一集即将播放"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/auto_next_episode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/color_02F8E1"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/auto_next_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:textColor="@color/color_99FFFFFF"
            android:textSize="@dimen/ts_20" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/auto_next_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_44"
                android:background="@drawable/selector_player_control_button"
                android:clickable="true"
                android:contentDescription="取消自动播放下一集"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_15"
                android:paddingRight="@dimen/vs_15"
                android:text="取消"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/auto_next_now"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_44"
                android:layout_marginLeft="@dimen/vs_8"
                android:background="@drawable/selector_player_control_button"
                android:clickable="true"
                android:contentDescription="立即播放下一集"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_15"
                android:paddingRight="@dimen/vs_15"
                android:text="立即播放"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/img_layout" android:layout_width="48dp"
        android:layout_height="48dp" android:layout_gravity="start|center_vertical"
        android:layout_marginLeft="24dp" android:visibility="gone">
        <ImageView android:id="@+id/lock_img" style="@style/PlayerOverlayIcon"
            android:src="@drawable/ic_player_unlock" android:contentDescription="锁定或解锁播放控制" />
    </FrameLayout>

</FrameLayout>
