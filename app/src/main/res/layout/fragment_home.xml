<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="MissingDefaultResource">

    <!-- 底部：节目信息 + 大卡片横向流 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_50"
        android:paddingRight="@dimen/vs_50"
        android:paddingBottom="@dimen/vs_24">

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_40"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHeroNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_hero_note"
                android:focusable="false"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_10"
                android:paddingTop="@dimen/vs_2"
                android:paddingRight="@dimen/vs_10"
                android:paddingBottom="@dimen/vs_2"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHeroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_10"
                android:ellipsize="end"
                android:focusable="false"
                android:singleLine="true"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeroDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:ellipsize="end"
            android:focusable="false"
            android:singleLine="true"
            android:textColor="@color/color_BBFFFFFF"
            android:textSize="@dimen/ts_20"
            android:visibility="gone" />

        <!-- 下方列表的分区标题：标题与副信息同一行，避免两行叠字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="豆瓣推荐"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHomeSub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_12"
                android:layout_weight="1"
                android:ellipsize="end"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:singleLine="true"
                android:text="正在获取…"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_card_row_height"
                android:clipChildren="false"
                android:clipToPadding="false"
                >

                <com.github.tvbox.osc.ui.tv.widget.HomeCardRecyclerView
                    android:id="@+id/tvHotList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_8"
                    app:tv_horizontalSpacingWithMargins="@dimen/home_card_spacing"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_16" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>


</FrameLayout>
