<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_44"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <View
        android:id="@+id/vRailBar"
        android:layout_width="@dimen/vs_5"
        android:layout_height="@dimen/vs_22"
        android:layout_gravity="left|center_vertical"
        android:layout_marginLeft="@dimen/vs_4"
        android:background="@drawable/selector_home_rail_bar"
        android:duplicateParentState="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_12"
        android:paddingRight="@dimen/vs_6">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:singleLine="true"
            android:textColor="@color/color_BBFFFFFF"
            android:textSize="@dimen/ts_26" />

        <ImageView
            android:id="@+id/tvFilter"
            android:layout_width="@dimen/vs_24"
            android:layout_height="@dimen/vs_24"
            android:layout_marginLeft="@dimen/vs_6"
            android:focusable="false"
            android:src="@drawable/icon_filter"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
