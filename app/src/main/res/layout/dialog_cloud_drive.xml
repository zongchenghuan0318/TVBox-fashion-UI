<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="960mm"
        android:layout_height="580mm"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:paddingLeft="26mm"
        android:paddingTop="20mm"
        android:paddingRight="26mm"
        android:paddingBottom="16mm">

        <!-- 顶部标题栏：与设置/聚合目录统一风格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnCloudBack"
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:background="@drawable/selector_settings_control"
                android:clickable="true"
                android:contentDescription="返回"
                android:focusable="true">

                <ImageView
                    android:layout_width="16mm"
                    android:layout_height="16mm"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings_back" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14mm"
                android:layout_marginRight="14mm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCloudTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:text="网盘与配置中心"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="22mm" />

                <TextView
                    android:id="@+id/tvCloudSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2mm"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="选择网盘扫码登录或管理云盘配置"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="14mm" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCloudSwitchSite"
                style="@style/SettingsButton"
                android:layout_marginRight="10mm"
                android:minWidth="112mm"
                android:minHeight="40mm"
                android:paddingLeft="16mm"
                android:paddingRight="16mm"
                android:text="切换站点"
                android:textSize="15mm" />

            <TextView
                android:id="@+id/btnCloudClose"
                style="@style/SettingsButton"
                android:minWidth="88mm"
                android:minHeight="40mm"
                android:paddingLeft="16mm"
                android:paddingRight="16mm"
                android:text="关闭"
                android:textSize="15mm" />
        </LinearLayout>

        <!-- 存储权限轻提示（未授权时才显示，避免部分老网盘源保存 Token 失败） -->
        <LinearLayout
            android:id="@+id/llCloudStorageBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12mm"
            android:background="@drawable/shape_settings_inset"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16mm"
            android:paddingTop="8mm"
            android:paddingRight="12mm"
            android:paddingBottom="8mm"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="提示：尚未授予本地存储权限，部分旧版网盘插件可能无法持久保存扫码登录态"
                android:textColor="@color/settings_warning"
                android:textSize="14mm" />

            <TextView
                android:id="@+id/btnCloudGrantStorage"
                style="@style/SettingsButton"
                android:layout_marginLeft="12mm"
                android:minWidth="92mm"
                android:minHeight="34mm"
                android:paddingLeft="14mm"
                android:paddingTop="5mm"
                android:paddingRight="14mm"
                android:paddingBottom="5mm"
                android:text="去授权"
                android:textSize="14mm" />
        </LinearLayout>

        <!-- 原始分类栏（不经过固定 5 分类过滤，完整保留网盘配置分类） -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/rvCloudTabs"
            android:layout_width="match_parent"
            android:layout_height="46mm"
            android:layout_marginTop="12mm"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:tv_horizontalSpacingWithMargins="8mm"
            app:tv_selectedItemIsCentered="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1mm"
            android:layout_marginTop="10mm"
            android:layout_marginBottom="12mm"
            android:background="#1AFFFFFF" />

        <!-- 主内容区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rvCloudItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_horizontalSpacingWithMargins="12mm"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="12mm" />

            <LinearLayout
                android:id="@+id/llCloudLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="42mm"
                    android:layout_height="42mm"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tvCloudLoadingTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:text="正在加载配置中心…"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="16mm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCloudEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:alpha="0.45"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_empty" />

                <TextView
                    android:id="@+id/tvCloudEmptyTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:gravity="center"
                    android:lineSpacingExtra="4mm"
                    android:maxWidth="540mm"
                    android:text="当前接口未找到配置中心或加载失败，可点击切换站点或重试"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="16mm" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16mm"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCloudRetry"
                        style="@style/SettingsButton.Primary"
                        android:minWidth="120mm"
                        android:minHeight="42mm"
                        android:text="重新加载"
                        android:textSize="16mm" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvCloudFooterHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10mm"
            android:text="方向键选择 · 确定键扫码登录或打开 · 右上角可切换不同网盘/配置站点"
            android:textColor="@color/settings_text_muted"
            android:textSize="13mm" />
    </LinearLayout>
</FrameLayout>
