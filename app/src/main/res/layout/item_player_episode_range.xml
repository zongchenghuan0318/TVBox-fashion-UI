<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="36mm"
    android:layout_marginRight="8mm"
    android:background="@drawable/selector_player_episode_tile"
    android:clipChildren="false"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/tvRangeTitle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:gravity="center"
        android:paddingLeft="14mm"
        android:paddingRight="14mm"
        android:singleLine="true"
        android:textColor="@color/selector_setting_title"
        android:textSize="14mm"
        tools:text="1-30" />
</FrameLayout>
