<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="600mm"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="28mm"
            android:paddingTop="22mm"
            android:paddingRight="28mm"
            android:paddingBottom="14mm"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="数据备份与还原"
                android:textColor="@color/color_FFFFFF"
                android:textSize="24mm"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvBackupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4mm"
                android:textColor="@color/settings_text_secondary"
                android:textSize="15mm"
                tools:text="存储权限已授权 · 共 2 份本地备份" />
        </LinearLayout>

        <View
            android:id="@+id/title_divider"
            android:layout_width="match_parent"
            android:layout_height="1mm"
            android:layout_marginLeft="24mm"
            android:layout_marginRight="24mm"
            android:background="#1AFFFFFF"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <LinearLayout
            android:id="@+id/backup_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14mm"
            android:orientation="horizontal"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            app:layout_constraintTop_toBottomOf="@id/title_divider">

            <TextView
                android:id="@+id/backupNow"
                android:layout_width="0dp"
                android:layout_height="44mm"
                android:layout_marginRight="8mm"
                android:layout_weight="1"
                android:background="@drawable/selector_update_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusRight="@+id/storagePermission"
                android:nextFocusDown="@+id/list"
                android:text="立即备份"
                android:textColor="@color/selector_update_action_text"
                android:textSize="18mm"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/storagePermission"
                android:layout_width="0dp"
                android:layout_height="44mm"
                android:layout_weight="1"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/backupNow"
                android:nextFocusDown="@+id/list"
                android:text="检查存储权限"
                android:textColor="@color/color_FFFFFF"
                android:textSize="18mm" />
        </LinearLayout>

        <TextView
            android:id="@+id/restore_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="28mm"
            android:paddingTop="16mm"
            android:paddingRight="28mm"
            android:paddingBottom="8mm"
            android:singleLine="true"
            android:text="历史备份（点击可还原或删除）"
            android:textColor="@color/settings_text_secondary"
            android:textSize="15mm"
            app:layout_constraintTop_toBottomOf="@id/backup_buttons" />

        <FrameLayout
            android:id="@+id/backupListBox"
            android:layout_width="match_parent"
            android:layout_height="260mm"
            android:paddingLeft="20mm"
            android:paddingRight="20mm"
            app:layout_constraintTop_toBottomOf="@id/restore_tip">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:tv_layoutManager="V7LinearLayoutManager"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="6mm" />

            <TextView
                android:id="@+id/tvBackupEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_settings_inset"
                android:gravity="center"
                android:lineSpacingExtra="4mm"
                android:padding="24mm"
                android:text="暂无本地备份\n点击上方「立即备份」保存当前接口配置、收藏与观看记录"
                android:textColor="@color/settings_text_muted"
                android:textSize="16mm"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="28mm"
            android:paddingTop="12mm"
            android:paddingRight="24mm"
            android:paddingBottom="18mm"
            app:layout_constraintTop_toBottomOf="@id/backupListBox">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="备份路径：/sdcard/tvbox_backup/"
                android:textColor="@color/settings_text_muted"
                android:textSize="14mm" />

            <TextView
                android:id="@+id/btnBackupClose"
                style="@style/SettingsButton"
                android:minWidth="110mm"
                android:text="关闭" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
