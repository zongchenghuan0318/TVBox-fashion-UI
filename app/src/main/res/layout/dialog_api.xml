<?xml version="1.0" encoding="utf-8"?>
 <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/vs_420"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="horizontal"
        android:padding="@dimen/vs_20">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_15"
                android:gravity="center"
                android:text="配置管理"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="@dimen/vs_310"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22"
                tools:text="1111111111111111111111111" />
            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="@dimen/vs_300"
                android:layout_height="@dimen/vs_300"
                android:focusable="false"
                android:src="@drawable/cs_ic_launcher" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="@dimen/vs_520"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_24"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_6"
                android:text="选择你的点播源"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_15"
                android:text="添加或切换配置地址，应用前会自动检查可用性"
                android:textColor="@color/color_6CFFFFFF"
                android:textSize="@dimen/ts_20" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ed_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_2"
                    android:layout_weight="1"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="输入配置源地址"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingLeft="@dimen/vs_2"
                    android:paddingTop="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_2"
                    android:paddingBottom="@dimen/vs_10"
                    android:textColor="@color/color_FFFFFF"
                    android:textColorHint="@color/color_6CFFFFFF" />

                <TextView
                    android:id="@+id/tv_test_http"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/vs_40"
                    android:padding="@dimen/vs_10"
                    android:text="测试连接"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_22" />
                <TextView
                    android:id="@+id/file_open_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/vs_5"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/vs_40"
                    android:padding="@dimen/vs_10"
                    android:text="本地文件"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_22" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_12"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/apiHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/vs_8"
                    android:layout_weight="1"
                    android:background="@drawable/button_dialog_main"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/vs_40"
                    android:padding="@dimen/vs_10"
                    android:text="配置库"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/apiSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/button_dialog_main"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/vs_40"
                    android:padding="@dimen/vs_10"
                    android:text="收藏地址"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVerifyStatus"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vs_15"
                android:layout_weight="1"
                android:background="@drawable/shape_edit_bg"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20"
                android:maxLines="3"
                android:text="输入或选择配置源地址，应用前会自动检查可用性"
                android:textColor="@color/color_6CFFFFFF"
                android:textSize="@dimen/ts_20"
                android:visibility="visible"
                tools:text="✓ 配置源可用" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_15"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/storagePermission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/vs_40"
                    android:padding="@dimen/vs_10"
                    android:text="取消"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:id="@+id/inputSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:layout_weight="1"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/vs_40"
                    android:padding="@dimen/vs_10"
                    android:text="确定"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_22" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>