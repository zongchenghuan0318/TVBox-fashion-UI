<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56mm"
    android:background="@drawable/selector_setting_row_unified"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="20mm"
    android:paddingRight="16mm"
    android:paddingTop="10mm"
    android:paddingBottom="10mm"
    android:stateListAnimator="@animator/setting_row_focus">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/selector_setting_title"
            android:textSize="18mm"
            android:fontFamily="sans-serif-medium"
            tools:text="ExoPlayer（推荐）" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3mm"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/settings_text_secondary"
            android:textSize="14mm"
            android:visibility="gone"
            tools:text="支持本地磁盘缓存，拖动回看更流畅" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12mm"
        android:background="@drawable/shape_settings_inset"
        android:paddingLeft="10mm"
        android:paddingRight="10mm"
        android:paddingTop="4mm"
        android:paddingBottom="4mm"
        android:text="✓ 当前"
        android:textColor="@color/settings_success"
        android:textSize="14mm"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />
</LinearLayout>
