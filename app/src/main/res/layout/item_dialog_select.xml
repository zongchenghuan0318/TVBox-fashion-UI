<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/vs_60"
    android:background="@drawable/selector_settings_action"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_20"
    android:paddingRight="@dimen/vs_20"
    android:paddingTop="@dimen/vs_12"
    android:paddingBottom="@dimen/vs_12">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22"
        tools:text="Apple TV 顶栏" />

    <TextView
        android:id="@+id/tvSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_4"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/color_rail_text_muted"
        android:textSize="@dimen/ts_16"
        android:visibility="gone"
        tools:text="顶部磨砂玻璃导航，沉浸式宽幅画报与平滑视差聚焦" />
</LinearLayout>
