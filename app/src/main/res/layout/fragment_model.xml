<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：左侧分组导航（播放 / 首页与搜索 / 数据与缓存 / 关于），右侧只显示当前分组 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="44mm"
    android:paddingRight="44mm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="6mm">

        <!-- ================= 左侧分组导航 ================= -->
        <LinearLayout
            android:layout_width="200mm"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navPlay"
                style="@style/SettingNavItem"
                android:text="播放" />

            <TextView
                android:id="@+id/navHome"
                style="@style/SettingNavItem"
                android:text="首页与搜索" />

            <TextView
                android:id="@+id/navData"
                style="@style/SettingNavItem"
                android:text="数据与缓存" />

            <TextView
                android:id="@+id/navAbout"
                style="@style/SettingNavItem"
                android:text="关于" />
        </LinearLayout>

        <!-- ================= 右侧分组内容 ================= -->
        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="24mm"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="36mm"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 分组：播放 -->
                <LinearLayout
                    android:id="@+id/groupPlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="播放器" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llPlay"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="播放器" />
                            <TextView android:id="@+id/tvPlay" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llMediaCodec"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="解码方式" />
                            <TextView android:id="@+id/tvMediaCodec" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llRender"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="渲染方式" />
                            <TextView android:id="@+id/tvRenderType" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llScale"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="画面比例" />
                            <TextView android:id="@+id/tvScaleType" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginTop="18mm"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="字幕与音轨" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llAudioLanguage"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="默认音轨" />
                            <TextView android:id="@+id/tvAudioLanguage" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llSubtitleLanguage"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="字幕语言" />
                            <TextView android:id="@+id/tvSubtitleLanguage" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llSubtitleOff"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="显示字幕" />
                            <Space style="@style/SettingRowSpacer" />
                            <com.github.tvbox.osc.ui.view.CapsuleSwitch
                                android:id="@+id/switchSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginTop="18mm"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="片头与片尾" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llPlayTimeStart"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="跳过片头" />
                            <TextView android:id="@+id/tvPlayTimeStart" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llPlayTimeEnd"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="跳过片尾" />
                            <TextView android:id="@+id/tvPlayTimeEnd" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llPlayTimeStep"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="调整步长" />
                            <TextView android:id="@+id/tvPlayTimeStep" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 分组：首页与搜索 -->
                <LinearLayout
                    android:id="@+id/groupHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="首页" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llHomeApi"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="首页数据源" />
                            <TextView android:id="@+id/tvHomeApi" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llHomeMode"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="首页模式" />
                            <TextView android:id="@+id/tvHomeMode" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llCardStyle"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="海报切换样式" />
                            <TextView android:id="@+id/tvCardStyle" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llHomeRec"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="首页推荐" />
                            <TextView android:id="@+id/tvHomeRec" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llHomeLayout"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="首页布局" />
                            <TextView android:id="@+id/tvHomeLayout" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginTop="18mm"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="搜索" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llSearchView"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="搜索展示" />
                            <TextView android:id="@+id/tvSearchView" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llSearchSite"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="搜索源管理" />
                            <TextView android:id="@+id/tvSearchSite" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 分组：数据与缓存 -->
                <LinearLayout
                    android:id="@+id/groupData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="内容来源" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llApi"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="配置接口" />
                            <TextView android:id="@+id/tvApi" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llLiveSource"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="直播源管理" />
                            <TextView android:id="@+id/tvLiveSource" style="@style/SettingRowValue" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginTop="18mm"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="缓存与备份" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llClearCache"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="清理应用缓存" />
                            <TextView android:id="@+id/tvClearCache" style="@style/SettingRowValue" android:text="一键释放" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llBackup"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="数据备份与还原" />
                            <TextView style="@style/SettingRowValue" android:text="本地备份" />
                            <TextView style="@style/SettingRowArrow" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 分组：关于 -->
                <LinearLayout
                    android:id="@+id/groupAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 软件更新横幅 -->
                    <LinearLayout
                        android:id="@+id/llAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52mm"
                        android:paddingLeft="18mm"
                        android:paddingRight="18mm"
                        android:paddingTop="10mm"
                        android:paddingBottom="10mm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/selector_settings_update">

                        <ImageView
                            android:layout_width="36mm"
                            android:layout_height="36mm"
                            android:padding="8mm"
                            android:background="@drawable/shape_update_glyph"
                            android:src="@drawable/ic_update_download"
                            android:tint="#FFFFFF"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="14mm"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="软件更新"
                                android:textSize="19mm"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#FFFFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2mm"
                                android:text="检查最新版本与系统功能优化"
                                android:textSize="13mm"
                                android:textColor="@color/settings_text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/versionTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="14mm"
                            android:paddingLeft="12mm"
                            android:paddingRight="12mm"
                            android:paddingTop="4mm"
                            android:paddingBottom="4mm"
                            android:background="@drawable/shape_settings_inset"
                            android:textSize="14mm"
                            android:textColor="@color/settings_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检查更新  ›"
                            android:textSize="16mm"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFFFFFFF" />
                    </LinearLayout>

                    <TextView style="@style/SettingSectionTitle"
                        android:layout_marginTop="18mm"
                        android:layout_marginBottom="8mm"
                        android:layout_marginLeft="6mm"
                        android:text="更新与辅助" />

                    <LinearLayout style="@style/SettingGroup">
                        <LinearLayout
                            android:id="@+id/llAutoUpdate"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="启动时自动检查更新" />
                            <Space style="@style/SettingRowSpacer" />
                            <com.github.tvbox.osc.ui.view.CapsuleSwitch
                                android:id="@+id/switchAutoUpdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llRemoteKeySound"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="遥控器按键音" />
                            <Space style="@style/SettingRowSpacer" />
                            <com.github.tvbox.osc.ui.view.CapsuleSwitch
                                android:id="@+id/switchRemoteKeySound"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout
                            android:id="@+id/llSeniorMode"
                            style="@style/SettingRow">
                            <TextView style="@style/SettingRowTitle" android:text="长辈模式" />
                            <Space style="@style/SettingRowSpacer" />
                            <com.github.tvbox.osc.ui.view.CapsuleSwitch
                                android:id="@+id/switchSeniorMode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10mm"
                        android:paddingLeft="8mm"
                        android:paddingRight="8mm"
                        android:text="长辈模式可放大文字并增强遥控器焦点。"
                        android:textSize="13mm"
                        android:lineSpacingExtra="3mm"
                        android:textColor="@color/settings_text_muted" />

                    <!-- 隐藏的调试入口：通过设置页彩蛋解锁 -->
                    <LinearLayout
                        android:id="@+id/llDebug"
                        style="@style/SettingRow"
                        android:visibility="gone">
                        <TextView style="@style/SettingRowTitle" android:text="调试模式" />
                        <TextView android:id="@+id/tvDebugOpen" style="@style/SettingRowValue" />
                        <TextView style="@style/SettingRowArrow" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
