<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/vs_20">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:orientation="vertical">

            <!--调试模式：连按 4 次 0 后显示，默认隐藏-->
            <LinearLayout
                android:id="@+id/llDebug"
                style="@style/SettingRow"
                android:layout_height="@dimen/vs_50"
                android:visibility="gone">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="调试模式" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvDebugOpen"
                    style="@style/SettingRowValue"
                    android:ellipsize="none" />

                <TextView style="@style/SettingRowArrow" />
            </LinearLayout>

            <TextView
                style="@style/SettingSectionTitle"
                android:text="接口与数据源" />

            <LinearLayout
                android:id="@+id/llApi"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="设置配置文件" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvApi"
                    style="@style/SettingRowValue" />

                <TextView style="@style/SettingRowArrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHomeApi"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="默认网站" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvHomeApi"
                    style="@style/SettingRowValue" />

                <TextView style="@style/SettingRowArrow" />
            </LinearLayout>

            <TextView
                style="@style/SettingSectionTitle"
                android:text="首页与搜索" />

            <LinearLayout style="@style/SettingRowPair">

                <LinearLayout
                    android:id="@+id/llHomeRec"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="@dimen/vs_5"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="首页推荐" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvHomeRec"
                        style="@style/SettingRowValue"
                        android:ellipsize="none" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSearchView"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="搜索展示" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSearchView"
                        style="@style/SettingRowValue"
                        android:ellipsize="none" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSearchSite"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="搜索源管理" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSearchSite"
                    style="@style/SettingRowValue" />

                <TextView style="@style/SettingRowArrow" />
            </LinearLayout>

            <TextView
                style="@style/SettingSectionTitle"
                android:text="播放" />

            <LinearLayout style="@style/SettingRowPair">

                <LinearLayout
                    android:id="@+id/llPlay"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="@dimen/vs_5"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="播放器" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvPlay"
                        style="@style/SettingRowValue"
                        android:ellipsize="none" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llMediaCodec"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="IJK解码方式" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvMediaCodec"
                        style="@style/SettingRowValue"
                        android:ellipsize="none" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SettingRowPair"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llRender"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="@dimen/vs_5"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="渲染方式" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvRenderType"
                        style="@style/SettingRowValue"
                        android:ellipsize="none" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llScale"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="画面缩放" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvScaleType"
                        style="@style/SettingRowValue"
                        android:ellipsize="none" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SettingRowPair"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llParseWebVew"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="@dimen/vs_5"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="嗅探Webview" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvParseWebView"
                        style="@style/SettingRowValue"
                        android:ellipsize="none"
                        android:text="系统自带" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDns"
                    style="@style/SettingRow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_5"
                    android:layout_marginStart="@dimen/vs_5"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingRowTitle"
                        android:text="安全DNS" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDns"
                        style="@style/SettingRowValue"
                        android:ellipsize="none" />

                    <TextView style="@style/SettingRowArrow" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SettingSectionTitle"
                android:text="其他" />

            <LinearLayout
                android:id="@+id/llBackup"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="分享给好友" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView style="@style/SettingRowArrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAbout"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingRowTitle"
                    android:text="关于" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/versionTV"
                    style="@style/SettingRowValue" />

                <TextView style="@style/SettingRowArrow" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
