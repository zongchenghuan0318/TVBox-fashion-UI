<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_76"
    android:background="@drawable/selector_player_episode_tile"
    android:clipChildren="false"
    android:focusable="true">

    <TextView
        android:id="@+id/tvEpisodeName"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingLeft="@dimen/vs_10"
        android:paddingRight="@dimen/vs_10"
        android:singleLine="true"
        android:textColor="@color/selector_player_episode_text"
        android:textSize="@dimen/ts_22"
        tools:text="第 01 集" />

    <View
        android:id="@+id/vEpisodeCurrent"
        android:layout_width="@dimen/vs_28"
        android:layout_height="@dimen/vs_3"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/vs_8"
        android:background="@drawable/shape_player_episode_accent_bar"
        android:visibility="gone" />
</FrameLayout>
