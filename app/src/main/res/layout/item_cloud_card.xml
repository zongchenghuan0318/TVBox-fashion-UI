<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_settings_action"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="136mm"
    android:orientation="vertical"
    android:padding="14mm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="54mm"
            android:layout_height="54mm"
            android:background="@drawable/shape_settings_inset"
            android:padding="4mm">

            <ImageView
                android:id="@+id/ivCloudCardPic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerInside" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvCloudCardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_settings_inset"
            android:paddingLeft="10mm"
            android:paddingTop="3mm"
            android:paddingRight="10mm"
            android:paddingBottom="3mm"
            android:singleLine="true"
            android:textColor="@color/settings_info"
            android:textSize="12mm"
            android:visibility="gone"
            tools:text="扫码"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCloudCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12mm"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/color_FFFFFF"
        android:textSize="17mm"
        tools:text="夸克扫码登录" />

    <TextView
        android:id="@+id/tvCloudCardNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4mm"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/settings_text_secondary"
        android:textSize="13mm"
        tools:text="点击弹出二维码" />
</LinearLayout>
