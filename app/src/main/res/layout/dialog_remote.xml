<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_440"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="无线互联 · 远程控制"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_marginBottom="@dimen/vs_20"
            android:gravity="center"
            android:text="请用同一局域网下的手机或电脑扫码访问"
            android:textColor="@color/color_6CFFFFFF"
            android:textSize="@dimen/ts_18" />

        <FrameLayout
            android:layout_width="@dimen/vs_240"
            android:layout_height="@dimen/vs_240"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_qr_container"
            android:padding="@dimen/vs_10">

            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:background="@drawable/shape_settings_inset"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:paddingLeft="@dimen/vs_16"
            android:paddingTop="@dimen/vs_12"
            android:paddingRight="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_12"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_20"
            tools:text="手机/电脑扫描上方二维码或浏览器访问\nhttp://192.168.1.88:9978" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_14"
            android:gravity="center"
            android:text="支持远程搜索 · 视频推送 · 配置同步 · 文件管理"
            android:textColor="@color/color_6CFFFFFF"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>
</FrameLayout>