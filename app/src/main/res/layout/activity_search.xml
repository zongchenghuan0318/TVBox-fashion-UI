<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="@dimen/vs_420"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/search_parent_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/back_tv"
                    android:layout_width="@dimen/vs_20"
                    android:layout_height="@dimen/vs_50"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:scaleType="fitXY"
                    android:src="@drawable/browser_back_selector"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_50"
                    android:background="@drawable/input_search"
                    android:hint="请输入要搜索的内容"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_toRightOf="@id/back_tv"
                    android:imeOptions="actionSearch"
                    android:paddingLeft="@dimen/vs_45"
                    android:paddingRight="@dimen/vs_10"
                    android:textColor="@android:color/white"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="@dimen/ts_20" />

                <ImageView
                    android:id="@+id/search_img"
                    android:layout_width="@dimen/vs_35"
                    android:layout_height="@dimen/vs_35"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="@dimen/vs_2"
                    android:layout_marginRight="@dimen/vs_10"
                    android:layout_centerVertical="true"
                    android:alpha="0.75"
                    android:clickable="true"
                    android:src="@drawable/selector_btn_search" />

                <TextView
                    android:id="@+id/tvSearch"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_40"
                    android:layout_marginRight="@dimen/vs_4"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/selector_user_focus"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:text="搜索"
                    android:textColor="@android:color/white" />
            </RelativeLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/serch_history_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_1"
                android:focusableInTouchMode="true"
                android:focusable="true"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_2"
                app:tv_verticalSpacingWithMargins="@dimen/vs_2"
                app:tv_layoutManager="V7LinearLayoutManager"
                />

            <LinearLayout
                android:id="@+id/llClearHistory"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_50"
                android:layout_marginTop="@dimen/vs_2"
                android:visibility="visible"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvClear"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_weight="1"
                    android:background="@drawable/selector_user_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="清空历史"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />
                <Space
                    android:layout_width="@dimen/vs_10"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
            android:id="@+id/keyBoardRoot"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/remoteRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/vs_20"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />

            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="@dimen/vs_300"
                android:layout_height="@dimen/vs_300"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/vs_20" />
        </LinearLayout>
    </LinearLayout>

    <!-- 热词/联想列：只在真有内容时才出现，避免空占一条竖栏 -->
    <LinearLayout
        android:id="@+id/llWord"
        android:layout_width="@dimen/vs_150"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_10"
        android:paddingBottom="@dimen/vs_20"
        android:paddingRight="@dimen/vs_10"
        android:visibility="gone">

        <TextView
            android:id="@+id/hot_lable_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/vs_6"
            android:text="热门搜索"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewWord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSearchProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/color_rail_text_muted"
                android:textSize="@dimen/ts_16"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRetrySearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="@dimen/vs_10"
                android:background="@drawable/selector_user_focus"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/vs_120"
                android:paddingStart="@dimen/vs_12"
                android:paddingEnd="@dimen/vs_12"
                android:text="重试未响应来源"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16"
                android:visibility="gone" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/sortRV"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="invisible"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>
</LinearLayout>
