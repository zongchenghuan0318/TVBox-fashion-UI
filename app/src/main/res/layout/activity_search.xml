<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/llSearchLeftPanel"
        android:layout_width="404mm"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16mm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8mm"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/search_parent_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/back_tv"
                    android:layout_width="@dimen/vs_42"
                    android:layout_height="@dimen/vs_42"
                    android:layout_marginRight="@dimen/vs_8"
                    android:background="@drawable/selector_home_top_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_back"
                    android:visibility="visible" />

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="46mm"
                        android:background="@drawable/input_search"
                        android:hint="请输入片名或首字母"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:paddingLeft="38mm"
                        android:paddingRight="34mm"
                        android:textColor="@android:color/white"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="18mm" />

                    <ImageView
                        android:id="@+id/search_img"
                        android:layout_width="26mm"
                        android:layout_height="26mm"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="8mm"
                        android:layout_centerVertical="true"
                        android:alpha="0.7"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:src="@drawable/selector_btn_search" />

                    <TextView
                        android:id="@+id/ivClearInput"
                        android:layout_width="30mm"
                        android:layout_height="30mm"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="4mm"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="×"
                        android:textColor="#CCFFFFFF"
                        android:textSize="20mm"
                        android:visibility="gone" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvSearch"
                    android:layout_width="wrap_content"
                    android:minWidth="@dimen/vs_60"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/vs_42"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:background="@drawable/selector_user_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_12"
                    android:paddingRight="@dimen/vs_12"
                    android:paddingTop="6mm"
                    android:paddingBottom="6mm"
                    android:singleLine="true"
                    android:text="搜索"
                    android:textColor="@android:color/white"
                    android:textSize="18mm" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/serch_history_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4mm"
                android:fadingEdgeLength="24mm"
                android:requiresFadingEdge="horizontal"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_2"
                app:tv_verticalSpacingWithMargins="@dimen/vs_2"
                app:tv_layoutManager="V7LinearLayoutManager"
                />

            <LinearLayout
                android:id="@+id/llClearHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38mm"
                android:layout_marginTop="4mm"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="38mm"
                    android:layout_weight="1"
                    android:background="@drawable/selector_user_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="5mm"
                    android:paddingBottom="5mm"
                    android:singleLine="true"
                    android:text="清空历史"
                    android:textColor="@android:color/white"
                    android:textSize="17mm" />
                <Space
                    android:layout_width="@dimen/vs_10"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 操作提示：长按历史词删除单条（遥控器与触屏都适用） -->
            <TextView
                android:id="@+id/tvHistoryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3mm"
                android:gravity="center"
                android:singleLine="true"
                android:text="长按历史词可删除单条 · 左右滑动查看更多"
                android:textColor="@color/color_rail_text_muted"
                android:textSize="14mm"
                android:visibility="gone" />
        </LinearLayout>

        <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
            android:id="@+id/keyBoardRoot"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nextFocusRight="@+id/sortRV" />

        <LinearLayout
            android:id="@+id/remoteRoot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnBackToKeyboard"
                android:layout_width="match_parent"
                android:layout_height="44mm"
                android:layout_marginTop="4mm"
                android:background="@drawable/selector_user_focus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="返回虚拟键盘"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8mm"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@android:color/white"
                android:textSize="17mm" />

            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="240mm"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8mm"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <!-- 热词/联想列：只在真有内容时才出现，避免空占一条竖栏 -->
    <LinearLayout
        android:id="@+id/llWord"
        android:layout_width="156mm"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_10"
        android:paddingBottom="@dimen/vs_20"
        android:paddingRight="@dimen/vs_10"
        android:visibility="gone">

        <TextView
            android:id="@+id/hot_lable_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/vs_6"
            android:text="热门搜索"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewWord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 聚合目录模式专用顶栏（从首页/分类直接打开聚合目录时显示，无左侧键盘） -->
        <LinearLayout
            android:id="@+id/llFolderHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="28mm"
            android:paddingTop="16mm"
            android:paddingRight="28mm"
            android:paddingBottom="10mm"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btnFolderModeBack"
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:background="@drawable/selector_settings_control"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="返回"
                android:nextFocusDown="@+id/sortRV">

                <ImageView
                    android:layout_width="16mm"
                    android:layout_height="16mm"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings_back"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14mm"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFolderModeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="22mm"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvFolderModeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2mm"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="14mm" />
            </LinearLayout>
        </LinearLayout>

        <!-- 顶部独立轻量搜索状态栏：搜索中显示进度，搜完后保留结果统计与「搜索源筛选」常驻入口 -->
        <LinearLayout
            android:id="@+id/llSearchStatusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20mm"
            android:paddingTop="14mm"
            android:paddingRight="20mm"
            android:paddingBottom="4mm"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbSearchLoading"
                android:layout_width="20mm"
                android:layout_height="20mm"
                android:layout_marginRight="8mm"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSearchProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_settings_inset"
                android:ellipsize="end"
                android:paddingLeft="14mm"
                android:paddingTop="6mm"
                android:paddingRight="14mm"
                android:paddingBottom="6mm"
                android:singleLine="true"
                android:textColor="@color/settings_text_secondary"
                android:textSize="15mm"
                android:visibility="visible" />

            <TextView
                android:id="@+id/btnCloudLoginTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36mm"
                android:layout_marginLeft="10mm"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="14mm"
                android:paddingTop="6mm"
                android:paddingRight="14mm"
                android:paddingBottom="6mm"
                android:singleLine="true"
                android:text="网盘登录"
                android:textColor="@color/color_FFFFFF"
                android:textSize="14mm"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnManageSearchSourcesTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36mm"
                android:layout_marginLeft="10mm"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="14mm"
                android:paddingTop="6mm"
                android:paddingRight="14mm"
                android:paddingBottom="6mm"
                android:singleLine="true"
                android:text="搜索源筛选"
                android:textColor="@color/color_FFFFFF"
                android:textSize="14mm" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="16mm"
            android:paddingTop="12mm"
            android:paddingRight="16mm"
            android:paddingBottom="16mm">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/sortRV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible"
                android:nextFocusLeft="@+id/keyBoardRoot"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_5" />

            <!-- 初始空白态操作引导：进入搜索页尚未输入前显示 -->
            <LinearLayout
                android:id="@+id/llSearchGuide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <ImageView
                    android:layout_width="64mm"
                    android:layout_height="64mm"
                    android:alpha="0.4"
                    android:src="@drawable/icon_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14mm"
                    android:text="输入片名、演员或拼音首字母开始搜索"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8mm"
                    android:text="可直接点选热词/历史，或按键盘底部「扫码搜」用手机输入"
                    android:textColor="@color/color_rail_text_muted"
                    android:textSize="17mm" />
            </LinearLayout>

            <!-- 首包到达前的居中加载反馈 -->
            <LinearLayout
                android:id="@+id/llSearchLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="46mm"
                    android:layout_height="46mm"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tvSearchLoadingTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14mm"
                    android:text="正在聚合搜索…"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <!-- 空结果提示：叠加在结果列表上方居中显示 -->
            <LinearLayout
                android:id="@+id/llSearchEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="@dimen/vs_80"
                    android:alpha="0.45"
                    android:src="@drawable/icon_empty" />

                <TextView
                    android:id="@+id/tvSearchEmptyTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_14"
                    android:text="未找到相关影视资源"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_6"
                    android:text="建议缩短片名，或在搜索源管理中开启更多数据源"
                    android:textColor="@color/color_rail_text_muted"
                    android:textSize="@dimen/ts_20" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_16"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEmptyRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/vs_44"
                        android:layout_marginRight="12mm"
                        android:background="@drawable/selector_settings_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="@dimen/vs_20"
                        android:paddingTop="8mm"
                        android:paddingRight="@dimen/vs_20"
                        android:paddingBottom="8mm"
                        android:singleLine="true"
                        android:text="重新搜索"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/btnEmptyManageSources"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/vs_44"
                        android:background="@drawable/selector_settings_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="@dimen/vs_20"
                        android:paddingTop="8mm"
                        android:paddingRight="@dimen/vs_20"
                        android:paddingBottom="8mm"
                        android:singleLine="true"
                        android:text="搜索源管理"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
