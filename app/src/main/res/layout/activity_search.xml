<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/llSearchLeftPanel"
        android:layout_width="@dimen/vs_420"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/search_parent_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/back_tv"
                    android:layout_width="@dimen/vs_42"
                    android:layout_height="@dimen/vs_42"
                    android:layout_marginRight="@dimen/vs_8"
                    android:background="@drawable/selector_home_top_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_back"
                    android:visibility="visible" />

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_50"
                        android:background="@drawable/input_search"
                        android:hint="请输入要搜索的内容"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSearch"
                        android:paddingLeft="@dimen/vs_45"
                        android:paddingRight="@dimen/vs_10"
                        android:textColor="@android:color/white"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="@dimen/ts_20" />

                    <ImageView
                        android:id="@+id/search_img"
                        android:layout_width="@dimen/vs_35"
                        android:layout_height="@dimen/vs_35"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="@dimen/vs_6"
                        android:layout_centerVertical="true"
                        android:alpha="0.75"
                        android:clickable="true"
                        android:src="@drawable/selector_btn_search" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvSearch"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_42"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:background="@drawable/selector_user_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:text="搜索"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/serch_history_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_1"
                android:focusableInTouchMode="true"
                android:focusable="true"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_2"
                app:tv_verticalSpacingWithMargins="@dimen/vs_2"
                app:tv_layoutManager="V7LinearLayoutManager"
                />

            <LinearLayout
                android:id="@+id/llClearHistory"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_50"
                android:layout_marginTop="@dimen/vs_2"
                android:visibility="visible"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvClear"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_50"
                    android:layout_weight="1"
                    android:background="@drawable/selector_user_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="清空历史"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_20" />
                <Space
                    android:layout_width="@dimen/vs_10"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 操作提示：长按历史词删除单条（遥控器与触屏都适用） -->
            <TextView
                android:id="@+id/tvHistoryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:gravity="center"
                android:text="长按历史词可删除单条"
                android:textColor="@color/color_rail_text_muted"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
            android:id="@+id/keyBoardRoot"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nextFocusRight="@+id/sortRV" />

        <LinearLayout
            android:id="@+id/remoteRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/vs_20"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />

            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="@dimen/vs_300"
                android:layout_height="@dimen/vs_300"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/vs_20" />
        </LinearLayout>
    </LinearLayout>

    <!-- 热词/联想列：只在真有内容时才出现，避免空占一条竖栏 -->
    <LinearLayout
        android:id="@+id/llWord"
        android:layout_width="@dimen/vs_150"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_10"
        android:paddingBottom="@dimen/vs_20"
        android:paddingRight="@dimen/vs_10"
        android:visibility="gone">

        <TextView
            android:id="@+id/hot_lable_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/vs_6"
            android:text="热门搜索"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewWord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 聚合目录模式专用顶栏（从首页/分类直接打开聚合目录时显示，无左侧键盘） -->
        <LinearLayout
            android:id="@+id/llFolderHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="28mm"
            android:paddingTop="16mm"
            android:paddingRight="28mm"
            android:paddingBottom="10mm"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btnFolderModeBack"
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:background="@drawable/selector_settings_control"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="返回"
                android:nextFocusDown="@+id/sortRV">

                <ImageView
                    android:layout_width="16mm"
                    android:layout_height="16mm"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings_back"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14mm"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFolderModeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="22mm"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvFolderModeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2mm"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="14mm" />
            </LinearLayout>
        </LinearLayout>

        <!-- 顶部独立轻量搜索状态栏：不遮挡下方第一行海报 -->
        <LinearLayout
            android:id="@+id/llSearchStatusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20mm"
            android:paddingTop="14mm"
            android:paddingRight="20mm"
            android:paddingBottom="4mm"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSearchProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_settings_inset"
                android:ellipsize="end"
                android:paddingLeft="14mm"
                android:paddingTop="6mm"
                android:paddingRight="14mm"
                android:paddingBottom="6mm"
                android:singleLine="true"
                android:textColor="@color/settings_text_secondary"
                android:textSize="15mm"
                android:visibility="visible" />

            <TextView
                android:id="@+id/btnManageSearchSourcesTop"
                android:layout_width="wrap_content"
                android:layout_height="34mm"
                android:layout_marginLeft="10mm"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="14mm"
                android:paddingRight="14mm"
                android:text="搜索源筛选"
                android:textColor="@color/color_FFFFFF"
                android:textSize="14mm" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="@dimen/vs_20"
            android:paddingTop="12mm"
            android:paddingRight="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_20">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/sortRV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible"
                android:nextFocusLeft="@+id/keyBoardRoot"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_5" />

            <!-- 空结果提示：叠加在结果列表上方居中显示 -->
            <LinearLayout
                android:id="@+id/llSearchEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="@dimen/vs_80"
                    android:alpha="0.45"
                    android:src="@drawable/icon_empty" />

                <TextView
                    android:id="@+id/tvSearchEmptyTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_14"
                    android:text="未找到相关影视资源"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_6"
                    android:text="建议缩短片名，或在搜索源管理中开启更多数据源"
                    android:textColor="@color/color_rail_text_muted"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/btnEmptyManageSources"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/vs_44"
                    android:layout_marginTop="@dimen/vs_16"
                    android:background="@drawable/selector_settings_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_20"
                    android:paddingRight="@dimen/vs_20"
                    android:text="搜索源管理"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
