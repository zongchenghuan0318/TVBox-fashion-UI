<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="640mm"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="28mm"
            android:paddingTop="22mm"
            android:paddingRight="28mm"
            android:paddingBottom="14mm"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="搜索源管理"
                android:textColor="@color/color_FFFFFF"
                android:textSize="24mm"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvSearchSiteSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4mm"
                android:textColor="@color/settings_text_secondary"
                android:textSize="15mm"
                tools:text="已选 12 / 18 个源 · 勾选顺序即搜索展示优先级" />
        </LinearLayout>

        <View
            android:id="@+id/title_divider"
            android:layout_width="match_parent"
            android:layout_height="1mm"
            android:layout_marginLeft="24mm"
            android:layout_marginRight="24mm"
            android:background="#1AFFFFFF"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12mm"
            android:orientation="horizontal"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            app:layout_constraintTop_toBottomOf="@id/title_divider">

            <TextView
                android:id="@+id/btnFastPreset"
                android:layout_width="0dp"
                android:layout_height="44mm"
                android:layout_weight="1.15"
                android:layout_marginRight="8mm"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:gravity="center"
                android:text="精选高速"
                android:textColor="@color/settings_success"
                android:textSize="17mm"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btnSelectAll"
                android:layout_width="0dp"
                android:layout_height="44mm"
                android:layout_weight="0.9"
                android:layout_marginRight="8mm"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:gravity="center"
                android:text="全选"
                android:textColor="@color/color_FFFFFF"
                android:textSize="17mm" />

            <TextView
                android:id="@+id/btnUnselectAll"
                android:layout_width="0dp"
                android:layout_height="44mm"
                android:layout_weight="0.9"
                android:layout_marginRight="8mm"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:gravity="center"
                android:text="全不选"
                android:textColor="@color/color_FFFFFF"
                android:textSize="17mm" />

            <TextView
                android:id="@+id/btnPinFirst"
                android:layout_width="0dp"
                android:layout_height="44mm"
                android:layout_weight="1.15"
                android:background="@drawable/selector_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:gravity="center"
                android:text="设首位优先"
                android:textColor="@color/color_FFFFFF"
                android:textSize="17mm" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="20mm"
            android:paddingTop="10mm"
            android:paddingRight="20mm"
            android:paddingBottom="8mm"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="380mm"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="6mm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="28mm"
            android:paddingTop="8mm"
            android:paddingRight="24mm"
            android:paddingBottom="18mm"
            app:layout_constraintTop_toBottomOf="@id/list">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="勾选实时保存 · 序号越小越优先搜索"
                android:textColor="@color/settings_text_muted"
                android:textSize="14mm" />

            <TextView
                android:id="@+id/btnSearchSiteDone"
                style="@style/SettingsButton.Primary"
                android:minWidth="110mm"
                android:text="完成" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
