<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/episodePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/shape_player_episode_panel"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_28"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_24"
        android:paddingBottom="@dimen/vs_20">

        <!-- 标题：选集 + 总集数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选集"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_34"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/episodeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_12"
                android:background="@drawable/shape_player_episode_count_pill"
                android:paddingLeft="@dimen/vs_10"
                android:paddingTop="@dimen/vs_3"
                android:paddingRight="@dimen/vs_10"
                android:paddingBottom="@dimen/vs_3"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16"
                tools:text="共 48 集" />
        </LinearLayout>

        <!-- 当前播放 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/vs_6"
                android:layout_height="@dimen/vs_6"
                android:background="@drawable/shape_player_episode_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_8"
                android:text="正在播放"
                android:textColor="@color/color_66FFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/episodeCurrent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_8"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20"
                tools:text="第 5 集" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_1"
            android:layout_marginTop="@dimen/vs_16"
            android:layout_marginBottom="@dimen/vs_10"
            android:background="#1AFFFFFF" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/episodeRangeRV"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_48"
            android:layout_marginBottom="@dimen/vs_8"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_8"
            tools:visibility="visible" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/episodeGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_6"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_8"
            app:tv_verticalSpacingWithMargins="@dimen/vs_8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:text="方向键选择 · 确定播放 · 返回关闭"
            android:textColor="@color/color_66FFFFFF"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>
</FrameLayout>
