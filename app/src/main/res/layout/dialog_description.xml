<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_24">

        <TextView
            android:id="@+id/tvDesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold"
            tools:text="剧情简介" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_1"
            android:layout_marginTop="@dimen/vs_12"
            android:layout_marginBottom="@dimen/vs_12"
            android:background="#1AFFFFFF" />

        <ScrollView
            android:id="@+id/svDesScroll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_280"
            android:focusable="true"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvDesFullContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:textColor="#E6FFFFFF"
                android:textSize="@dimen/ts_20"
                tools:text="影片详细剧情简介……" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_1"
            android:layout_marginTop="@dimen/vs_14"
            android:layout_marginBottom="@dimen/vs_14"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDesClose"
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_40"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:text="关闭"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
