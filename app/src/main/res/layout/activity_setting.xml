<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="@dimen/vs_180"
        android:layout_height="match_parent"
        android:background="@color/color_6632364E"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_10"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_10"
        android:paddingBottom="@dimen/vs_20"
        android:visibility="gone">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/sortRV"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </LinearLayout>

    <!-- 页头：返回胶囊 + 品牌标题 + 一句范围说明 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_120"
        android:paddingTop="@dimen/vs_40"
        android:paddingRight="@dimen/vs_120"
        android:paddingBottom="@dimen/vs_12">

        <FrameLayout
            android:id="@+id/title_setting_tv"
            android:layout_width="@dimen/vs_50"
            android:layout_height="@dimen/vs_50"
            android:background="@drawable/selector_setting_back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <ImageView
                android:layout_width="@dimen/vs_20"
                android:layout_height="@dimen/vs_20"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/browser_back_selector" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_22"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="设置"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_40"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_3"
                android:singleLine="true"
                android:text="接口 · 播放 · 显示"
                android:textColor="@color/color_rail_text_muted"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>

    <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
