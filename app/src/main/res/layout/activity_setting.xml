<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_page">

    <!-- 顶部状态栏：极简磨砂质感，紧凑精致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="44mm"
        android:paddingRight="44mm"
        android:paddingTop="16mm"
        android:paddingBottom="8mm">

        <!-- 磨砂圆形返回按钮 -->
        <FrameLayout
            android:id="@+id/title_setting_tv"
            android:layout_width="48mm"
            android:layout_height="48mm"
            android:background="@drawable/selector_settings_control"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:contentDescription="返回"
            android:nextFocusDown="@id/navPlay">

            <ImageView
                android:layout_width="18mm"
                android:layout_height="18mm"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings_back"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- 标题区域（支持触控彩蛋点击，不占用遥控器普通焦点路径） -->
        <LinearLayout
            android:id="@+id/settingEasterEggTrigger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14mm"
            android:paddingLeft="8mm"
            android:paddingRight="12mm"
            android:paddingTop="4mm"
            android:paddingBottom="4mm"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settingEasterEggTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="26mm"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2mm"
                android:text="把观看体验，调成你喜欢的样子"
                android:textSize="13mm"
                android:textColor="@color/settings_text_secondary" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1mm"
            android:layout_weight="1" />

        <!-- 右侧磨砂品牌微标签 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12mm"
            android:paddingRight="12mm"
            android:paddingTop="5mm"
            android:paddingBottom="5mm"
            android:background="@drawable/shape_settings_inset"
            android:text="Z 影视"
            android:textSize="13mm"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E0FFFFFF" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
