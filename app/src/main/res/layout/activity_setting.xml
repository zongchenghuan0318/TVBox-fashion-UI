<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_page">

    <!-- 保留现有设置菜单的数据容器 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/sortRV"
        android:layout_width="1mm"
        android:layout_height="1mm"
        android:visibility="gone" />

    <!-- 顶部状态栏：极简磨砂质感，紧凑精致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="44mm"
        android:paddingRight="44mm"
        android:paddingTop="20mm"
        android:paddingBottom="10mm">

        <!-- 磨砂圆形返回按钮 -->
        <FrameLayout
            android:id="@+id/title_setting_tv"
            android:layout_width="44mm"
            android:layout_height="44mm"
            android:background="@drawable/selector_settings_control"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:contentDescription="返回"
            android:nextFocusRight="@id/settingEasterEggTrigger"
            android:nextFocusDown="@id/llAbout">

            <ImageView
                android:layout_width="18mm"
                android:layout_height="18mm"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings_back"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- 标题区域（支持彩蛋点击） -->
        <LinearLayout
            android:id="@+id/settingEasterEggTrigger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16mm"
            android:paddingLeft="8mm"
            android:paddingRight="12mm"
            android:paddingTop="4mm"
            android:paddingBottom="4mm"
            android:background="@drawable/selector_setting_row"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/title_setting_tv"
            android:nextFocusDown="@id/llAbout"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settingEasterEggTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="28mm"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2mm"
                android:text="把观看体验，调成你喜欢的样子"
                android:textSize="14mm"
                android:textColor="@color/settings_text_secondary" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1mm"
            android:layout_weight="1" />

        <!-- 右侧磨砂品牌微标签 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="14mm"
            android:paddingRight="14mm"
            android:paddingTop="6mm"
            android:paddingBottom="6mm"
            android:background="@drawable/shape_settings_inset"
            android:text="Z 影视"
            android:textSize="14mm"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E0FFFFFF" />
    </LinearLayout>

    <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
