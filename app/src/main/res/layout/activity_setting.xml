<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_settings_page">
    <!-- 保留现有设置菜单的数据容器。 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/sortRV"
        android:layout_width="1mm" android:layout_height="1mm" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingLeft="64mm" android:paddingRight="64mm"
        android:paddingTop="26mm" android:paddingBottom="18mm">
        <FrameLayout android:id="@+id/title_setting_tv" android:layout_width="52mm"
            android:layout_height="52mm" android:background="@drawable/selector_settings_control"
            android:clickable="true" android:focusable="true" android:focusableInTouchMode="true"
            android:contentDescription="返回" android:nextFocusRight="@id/settingEasterEggTrigger"
            android:nextFocusDown="@id/llAbout">
            <ImageView android:layout_width="22mm" android:layout_height="22mm"
                android:layout_gravity="center" android:src="@drawable/ic_settings_back"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:id="@+id/settingEasterEggTrigger" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginLeft="20mm"
            android:paddingLeft="10mm" android:paddingRight="12mm" android:paddingTop="4mm" android:paddingBottom="4mm"
            android:background="@drawable/selector_setting_row" android:clickable="true" android:focusable="true"
            android:nextFocusLeft="@id/title_setting_tv" android:nextFocusDown="@id/llAbout"
            android:orientation="vertical">
            <TextView android:id="@+id/settingEasterEggTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="设置" android:textSize="34mm"
                android:fontFamily="sans-serif-medium" android:textColor="@color/settings_text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4mm" android:text="把观看体验，调成你喜欢的样子"
                android:textSize="16mm" android:textColor="@color/settings_text_muted" />
        </LinearLayout>
        <Space android:layout_width="0dp" android:layout_height="1mm" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingLeft="16mm" android:paddingRight="16mm" android:paddingTop="9mm" android:paddingBottom="9mm"
            android:background="@drawable/shape_settings_inset" android:text="Z 影视"
            android:textSize="18mm" android:fontFamily="sans-serif-medium" android:textColor="@color/settings_accent" />
    </LinearLayout>
    <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager android:id="@+id/viewPager"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
