<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <xyz.doikki.videoplayer.player.VideoView
        android:id="@+id/mVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <ProgressBar
        android:id="@+id/play_loading"
        android:layout_width="@dimen/vs_50"
        android:layout_height="@dimen/vs_50"
        android:layout_gravity="center"
        android:indeterminateBehavior="repeat"
        android:indeterminateDrawable="@drawable/anim_loading"
        android:indeterminateOnly="true" />

    <ImageView
        android:id="@+id/play_load_error"
        android:layout_width="@dimen/vs_50"
        android:layout_height="@dimen/vs_50"
        android:layout_gravity="center"
        android:alpha="0.75"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:src="@drawable/icon_error"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/play_load_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/vs_50"
        android:text="1111111111111"
        android:textColor="@color/color_CCFFFFFF"
        android:textSize="@dimen/ts_24" />

    <!-- 播放失败时的可聚焦操作：遥控器无需呼出控制栏即可重试或换集/换线路 -->
    <LinearLayout
        android:id="@+id/play_error_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/vs_120"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/play_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_44"
            android:background="@drawable/selector_resume_restart_hint"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="@dimen/vs_160"
            android:paddingLeft="@dimen/vs_16"
            android:paddingRight="@dimen/vs_16"
            android:nextFocusRight="@id/play_error_switch"
            android:text="重试本集"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/play_error_switch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_44"
            android:layout_marginLeft="@dimen/vs_16"
            android:background="@drawable/selector_resume_restart_hint"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="@dimen/vs_160"
            android:paddingLeft="@dimen/vs_16"
            android:paddingRight="@dimen/vs_16"
            android:nextFocusLeft="@id/play_error_retry"
            android:text="选集 / 换线路"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>

    <include layout="@layout/player_top_bar" />
    
    <!-- 续播轻量磨砂胶囊：展示续播时间点，默认聚焦「继续」，按右选「重头播」 -->
    <LinearLayout
        android:id="@+id/resume_restart_hint"
        android:layout_width="wrap_content"
        android:layout_height="36mm"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24mm"
        android:layout_marginBottom="24mm"
        android:background="@drawable/shape_resume_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14mm"
        android:paddingEnd="8mm"
        android:visibility="gone">

        <TextView
            android:id="@+id/resume_hint_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="已续播"
            android:textColor="#D9FFFFFF"
            android:textSize="14mm" />

        <View
            android:layout_width="1mm"
            android:layout_height="14mm"
            android:layout_marginStart="10mm"
            android:layout_marginEnd="8mm"
            android:background="#28FFFFFF" />

        <TextView
            android:id="@+id/resume_continue_btn"
            android:layout_width="wrap_content"
            android:layout_height="26mm"
            android:background="@drawable/selector_resume_restart_hint"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="10mm"
            android:paddingEnd="10mm"
            android:nextFocusRight="@id/resume_restart_btn"
            android:text="继续"
            android:textColor="@android:color/white"
            android:textSize="13mm" />

        <TextView
            android:id="@+id/resume_restart_btn"
            android:layout_width="wrap_content"
            android:layout_height="26mm"
            android:layout_marginStart="6mm"
            android:background="@drawable/selector_resume_restart_hint"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="10mm"
            android:paddingEnd="10mm"
            android:nextFocusLeft="@id/resume_continue_btn"
            android:text="重头播 · 6s"
            android:textColor="#D9FFFFFF"
            android:textSize="13mm" />
    </LinearLayout>
</FrameLayout>
