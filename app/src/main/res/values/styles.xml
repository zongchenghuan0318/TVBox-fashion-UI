<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/color_6200EE</item>
        <item name="colorPrimaryDark">@color/color_3700B3</item>
        <item name="colorAccent">@color/color_03DAC5</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>//全屏即无通知栏
        <item name="android:windowContentOverlay">@null</item>//是否有遮盖
        <item name="windowNoTitle">true</item>
        <item name="android:keepScreenOn">true</item>
        <!--        <item name="android:windowBackground">@drawable/main_bg</item>-->
        <item name="android:windowBackground">@drawable/app_bg</item>
    </style>
    <!-- 自定义dialog样式 -->
    <style name="CustomDialogStyle" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="CustomDialogStyleDim" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 播放页选集侧栏：从右侧滑入 -->
    <style name="PlayerEpisodeWindowAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/player_episode_in</item>
        <item name="android:windowExitAnimation">@anim/player_episode_out</item>
    </style>

    <!-- 系统 AlertDialog：深色主题，避免继承 Light 主题导致白底 -->
    <style name="DarkAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/shape_dialog_bg_main</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="android:textColorPrimary">@color/color_FFFFFF</item>
        <item name="android:textColorSecondary">@color/color_6CFFFFFF</item>
    </style>

    <!-- 设置页：分组标题（Apple TV 极简字标，弱化装饰、强化快速扫描） -->
    <style name="SettingSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">16mm</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 设置页：分组标题容器 -->
    <style name="SettingSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">16mm</item>
        <item name="android:layout_marginBottom">8mm</item>
        <item name="android:paddingLeft">6mm</item>
    </style>

    <!-- 设置页：一组设置行共用的半透明磨砂玻璃卡片面板 -->
    <style name="SettingGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_setting_group</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">4mm</item>
    </style>

    <!-- 设置页：组内发丝分隔线（半透明白色发丝微切线） -->
    <style name="SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/vs_1</item>
        <item name="android:layout_marginLeft">14mm</item>
        <item name="android:layout_marginRight">14mm</item>
        <item name="android:background">#12FFFFFF</item>
    </style>

    <!-- 设置页：整行容器（圆角磨砂胶囊，遥控器交互） -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50mm</item>
        <item name="android:layout_marginBottom">@dimen/vs_0</item>
        <item name="android:background">@drawable/selector_setting_row</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">14mm</item>
        <item name="android:paddingRight">14mm</item>
        <item name="android:paddingTop">10mm</item>
        <item name="android:paddingBottom">10mm</item>
        <item name="android:stateListAnimator">@animator/setting_row_focus</item>
    </style>

    <!-- 设置页：并排两行的外层容器 -->
    <style name="SettingRowPair">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">false</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- 设置页：行标题 -->
    <style name="SettingRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/selector_setting_title</item>
        <item name="android:textSize">18mm</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <!-- 设置页：行当前值（聚焦时亮白，未聚焦中性灰；宽度吃满剩余空间并右对齐） -->
    <style name="SettingRowValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/selector_setting_value</item>
        <item name="android:textSize">16mm</item>
        <item name="android:layout_marginLeft">12mm</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <!-- 设置页：行末箭头（聚焦纯白，未聚焦中性微光） -->
    <style name="SettingRowArrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">8mm</item>
        <item name="android:layout_marginStart">8mm</item>
        <item name="android:text">›</item>
        <item name="android:textColor">@color/selector_setting_arrow</item>
        <item name="android:textSize">18mm</item>
        <item name="android:duplicateParentState">true</item>
    </style>
</resources>
