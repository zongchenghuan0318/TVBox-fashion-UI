<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 设置页颜色与首页共用同一套 token（color_home_base / color_rail_*），保证两页观感一致 -->
    <color name="settings_background">@color/color_home_base</color>
    <color name="settings_surface">#141820</color>
    <color name="settings_surface_raised">#1C2029</color>
    <color name="settings_border">@color/color_rail_glass_rim</color>
    <color name="settings_border_strong">@color/color_rail_stroke</color>
    <color name="settings_text">@color/color_rail_text_active</color>
    <color name="settings_text_secondary">@color/color_rail_text_muted</color>
    <color name="settings_text_muted">#66FFFFFF</color>

    <!-- 分组导航：与首页侧栏同款选中 / 焦点颜色 -->
    <color name="settings_nav_text_selected">@color/color_rail_text_active</color>
    <color name="settings_nav_text">@color/color_rail_text_muted</color>

    <color name="settings_accent">@color/color_rail_accent</color>
    <color name="settings_focus">#FFFFFFFF</color>
    <color name="settings_success">#34D399</color>
    <color name="settings_warning">#FBBF24</color>

    <style name="SettingsButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44mm</item>
        <item name="android:minWidth">100mm</item>
        <item name="android:paddingLeft">20mm</item>
        <item name="android:paddingRight">20mm</item>
        <item name="android:paddingTop">10mm</item>
        <item name="android:paddingBottom">10mm</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17mm</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/selector_settings_control</item>
    </style>
    <style name="SettingsButton.Primary" parent="SettingsButton">
        <item name="android:textColor">@color/selector_update_action_text</item>
        <item name="android:background">@drawable/selector_update_primary</item>
        <item name="android:minWidth">120mm</item>
    </style>
    <style name="UpdateCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14mm</item>
        <item name="android:textColor">@color/settings_text_muted</item>
    </style>
</resources>
