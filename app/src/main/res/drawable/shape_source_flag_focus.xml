<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_5" />
            <solid android:color="@color/color_02F8E1" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10mm" />
            <stroke android:width="2.5mm" android:color="@color/color_02F8E1" />
            <solid android:color="#3302F8E1" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="10mm" />
            <solid android:color="@color/color_6C3D3D3D" />
        </shape>
    </item>
</selector>
