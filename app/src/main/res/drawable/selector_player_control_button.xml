<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 播放控制器胶囊按键交互：半透明熏黑底衬，落焦纯白发光胶囊 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/radius_20" />
            <solid android:color="#4DFFFFFF" />
            <stroke android:width="1.5mm" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/radius_20" />
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:endColor="#26FFFFFF" />
            <stroke android:width="1.5mm" android:color="#A6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/radius_20" />
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1mm" android:color="#24FFFFFF" />
        </shape>
    </item>
</selector>
