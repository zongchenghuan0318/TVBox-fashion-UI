<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><corners android:radius="6mm" /><solid android:color="#161616" /><stroke android:width="1mm" android:color="#202020" /></shape></item>
    <item android:state_pressed="true"><shape><corners android:radius="6mm" /><solid android:color="#383838" /><stroke android:width="2mm" android:color="#FFFFFF" /></shape></item>
    <item android:state_focused="true"><shape><corners android:radius="6mm" /><solid android:color="#303030" /><stroke android:width="2mm" android:color="#FFFFFF" /></shape></item>
    <item android:state_selected="true"><shape><corners android:radius="6mm" /><solid android:color="#242424" /><stroke android:width="1mm" android:color="#454545" /></shape></item>
    <item ><shape><corners android:radius="6mm" /><solid android:color="#121212" /><stroke android:width="1mm" android:color="#121212" /></shape></item>
</selector>
