<?xml version="1.0" encoding="utf-8"?>
<!-- 软件更新卡片背景：纯中性深灰磨砂玻璃，聚焦时高亮浮起 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="16mm" />
            <gradient
                android:angle="90"
                android:startColor="#4DFFFFFF"
                android:endColor="#2EFFFFFF" />
            <stroke
                android:width="1.5mm"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16mm" />
            <solid android:color="#4DFFFFFF" />
            <stroke
                android:width="1.5mm"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16mm" />
            <gradient
                android:angle="270"
                android:startColor="#222530"
                android:endColor="#15171F" />
            <stroke
                android:width="1mm"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
