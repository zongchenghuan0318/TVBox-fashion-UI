<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点态：填充 + 发丝描边 + 左侧强调条 -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/vs_5" />
                    <solid android:color="@color/color_6632364E" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/vs_5" />
                    <stroke android:width="@dimen/vs_1" android:color="@color/color_rail_stroke" />
                </shape>
            </item>
            <item android:width="@dimen/vs_3" android:gravity="left|center_vertical">
                <shape>
                    <solid android:color="@color/color_0CADE2" />
                    <corners android:topRightRadius="@dimen/vs_3" android:bottomRightRadius="@dimen/vs_3" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- 未聚焦态：仅透明填充（无底部分隔线） -->
    <item android:state_focused="false">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/color_transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
