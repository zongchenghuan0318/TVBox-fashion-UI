<?xml version="1.0" encoding="utf-8"?>
<!-- 导航项：当前选中 —— 青蓝发光玻璃效果 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 外发光效果 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_10" />
            <solid android:color="#4D00D9FF" />
        </shape>
    </item>
    
    <!-- 主体玻璃层 -->
    <item
        android:top="@dimen/vs_1"
        android:bottom="@dimen/vs_1"
        android:left="@dimen/vs_1"
        android:right="@dimen/vs_1">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_10" />
            <gradient
                android:angle="135"
                android:startColor="#6600D9FF"
                android:centerColor="#4D00B8E6"
                android:endColor="#330099CC" />
            <stroke
                android:width="@dimen/vs_2"
                android:color="#9900D9FF" />
        </shape>
    </item>
    
    <!-- 顶部高光 -->
    <item
        android:top="@dimen/vs_2"
        android:left="@dimen/vs_2"
        android:right="@dimen/vs_2">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_10" />
            <gradient
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    
</layer-list>
