<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 顶栏圆形/胶囊微型动作按钮选择器 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="19mm" />
            <gradient
                android:angle="90"
                android:startColor="#4DFFFFFF"
                android:endColor="#26FFFFFF" />
            <stroke
                android:width="1.5mm"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="19mm" />
            <solid android:color="#40FFFFFF" />
            <stroke
                android:width="1.5mm"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="19mm" />
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1mm"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
