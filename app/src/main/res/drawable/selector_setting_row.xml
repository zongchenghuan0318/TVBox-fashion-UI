<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点态：轻柔青色填充 + 发丝描边，行内文字保持可读 -->
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_15" />
            <solid android:color="#290CADE2" />
            <stroke
                android:width="@dimen/vs_1"
                android:color="#660CADE2" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_15" />
            <solid android:color="@color/color_transparent" />
        </shape>
    </item>
</selector>
