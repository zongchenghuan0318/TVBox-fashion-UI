<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框输入框背景：落焦纯白切线边框，默认低调半透明描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10mm" />
            <stroke android:width="2mm" android:color="#D9FFFFFF" />
            <solid android:color="#1EFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10mm" />
            <stroke android:width="1mm" android:color="@color/color_rail_stroke" />
            <solid android:color="@color/color_dialog_field" />
        </shape>
    </item>
</selector>
