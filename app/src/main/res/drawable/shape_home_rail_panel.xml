<?xml version="1.0" encoding="utf-8"?>
<!--
  侧边栏面板：现代烟熏黑玻璃拟态 (Smoked Glassmorphism)
  - 彻底去除任何青蓝或彩色杂色，回归纯净高雅的中性深色黑玻璃
  - 水平方向平滑渐变，左侧较实确保文字绝对可读，右侧轻透让海报自然透出
  - 顶部微弱漫反射高光，还原精致物理玻璃质感
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 烟熏黑玻璃基底：从左至右纯净微透渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#E60A0C10"
                android:centerColor="#B80D0F14"
                android:endColor="#73090B0F" />
            <corners android:radius="@dimen/vs_0" />
        </shape>
    </item>

    <!-- 2. 顶部高光 - 玻璃微弱反光（纯白低透） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="@android:color/transparent"
                android:centerY="0.25" />
            <corners android:radius="@dimen/vs_0" />
        </shape>
    </item>

</layer-list>
