<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 选集方块遥控器交互：中性熏黑磨砂玻璃，落焦纯白发光胶囊 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/radius_10" />
            <solid android:color="#4DFFFFFF" />
            <stroke android:width="1.5mm" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/radius_10" />
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:endColor="#26FFFFFF" />
            <stroke android:width="1.5mm" android:color="#A6FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/radius_10" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1mm" android:color="#59FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/radius_10" />
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1mm" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
