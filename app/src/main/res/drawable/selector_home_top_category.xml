<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 顶栏横向分类药丸交互背景：纯净中性熏黑磨砂，落焦纯白发光胶囊 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 获得焦点态：纯白发光微透高光胶囊 -->
    <item android:state_focused="true">
        <shape>
            <corners android:radius="19mm" />
            <gradient
                android:angle="90"
                android:startColor="#4DFFFFFF"
                android:endColor="#26FFFFFF" />
            <stroke
                android:width="1.5mm"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
    <!-- 按下态 -->
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="19mm" />
            <solid android:color="#40FFFFFF" />
            <stroke
                android:width="1.5mm"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
    <!-- 选中态（当前浏览该分类，但焦点移动至下方内容海报） -->
    <item android:state_selected="true">
        <shape>
            <corners android:radius="19mm" />
            <solid android:color="#2BFFFFFF" />
            <stroke
                android:width="1mm"
                android:color="#59FFFFFF" />
        </shape>
    </item>
    <!-- 常态：极弱微透暗光胶囊 -->
    <item>
        <shape>
            <corners android:radius="19mm" />
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1mm"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
