<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈柔光 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2EFFFFFF" />
            <size
                android:width="12dp"
                android:height="12dp" />
        </shape>
    </item>
    <!-- 内芯 -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
</layer-list>
