<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 烟熏磨砂玻璃卡片：中性深色与柔光高亮边框 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#33FFFFFF"/>
            <stroke android:width="1.5dp" android:color="#E6FFFFFF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#26FFFFFF"/>
            <stroke android:width="1.5dp" android:color="#B3FFFFFF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#141820"/>
            <stroke android:width="1dp" android:color="#1AFFFFFF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
