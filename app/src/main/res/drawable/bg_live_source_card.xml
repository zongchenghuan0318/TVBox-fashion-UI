<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#26364A"/>
            <stroke android:width="2dp" android:color="#00D9FF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1B202D"/>
            <stroke android:width="1dp" android:color="#334052"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
