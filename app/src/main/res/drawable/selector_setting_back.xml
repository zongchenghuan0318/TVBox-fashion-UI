<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#59FFFFFF" />
            <stroke android:width="@dimen/vs_2" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#32FFFFFF" />
            <stroke android:width="@dimen/vs_2" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="@dimen/vs_1" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
