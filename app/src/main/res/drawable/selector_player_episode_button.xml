<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 选集面板次要按键交互 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/radius_5" />
            <solid android:color="#4DFFFFFF" />
            <stroke android:width="1.5mm" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/radius_5" />
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:endColor="#26FFFFFF" />
            <stroke android:width="1.5mm" android:color="#A6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/radius_5" />
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1mm" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
